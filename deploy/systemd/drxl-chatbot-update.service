[Unit]
Description=Crawl the ISSS website and update the search index
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/drxl-chatbot/run-job.sh update /opt/drxl-chatbot/compose.sh run --rm --no-deps app python scripts/update_index.py all
StandardOutput=append:/var/log/drxl-chatbot/jobs.log
StandardError=append:/var/log/drxl-chatbot/jobs.log
